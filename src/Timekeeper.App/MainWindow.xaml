<Window x:Class="Timekeeper.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Timekeeper" Icon="Assets/Timekeeper.ico" Style="{StaticResource {x:Type Window}}" Width="1360" Height="960" MinWidth="1040" MinHeight="720" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="NavIcon" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="16"/><Setter Property="Width" Value="20"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="StepNumber" TargetType="Border"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Width" Value="26"/><Setter Property="Height" Value="26"/><Setter Property="Margin" Value="0,0,10,0"/></Style>
    <Style x:Key="MetricLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="MetricValue" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="29"/><Setter Property="Margin" Value="0,9,0,0"/></Style>
    <Style x:Key="TableText" TargetType="TextBlock"><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
    <Style x:Key="TableNumber" TargetType="TextBlock" BasedOn="{StaticResource TableText}"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="HorizontalAlignment" Value="Right"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Sidebar}">
      <Grid Margin="18,28,18,22"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="7,0,0,30">
            <Grid Width="31" Height="36" Margin="0,0,10,0">
              <Ellipse Width="29" Height="29" Stroke="{DynamicResource Warm}" StrokeThickness="1.5"/>
              <Path Data="M 15,9 L 15,18 L 22,18" Stroke="{DynamicResource SidebarInk}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Ellipse Width="3" Height="3" Fill="{DynamicResource Warm}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"/>
            </Grid>
            <TextBlock Text="timekeeper" FontFamily="{StaticResource DisplayFont}" Foreground="{DynamicResource SidebarInk}" FontSize="23" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="WORKSPACE" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource SidebarMuted}" FontSize="10" Margin="15,0,0,12"/>
          <Button x:Name="DayNav" Style="{StaticResource Navigation}" Tag="Active" Click="ShowDay_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE787;" Style="{StaticResource NavIcon}"/><TextBlock Text="Timecards"/></StackPanel></Button>
          <Button x:Name="HistoryNav" Style="{StaticResource Navigation}" Click="History_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" Style="{StaticResource NavIcon}"/><TextBlock Text="Submission history"/></StackPanel></Button>
          <Border Background="{DynamicResource SidebarLine}" Height="1" Margin="14,16,14,21"/>
          <TextBlock Text="PREFERENCES &amp; HELP" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource SidebarMuted}" FontSize="10" Margin="15,0,0,12"/>
          <Button Style="{StaticResource Navigation}" Click="Settings_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/><TextBlock Text="Settings"/></StackPanel></Button>
          <Button Style="{StaticResource Navigation}" Click="Appearance_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" Style="{StaticResource NavIcon}"/><TextBlock Text="Appearance"/></StackPanel></Button>
          <Button Style="{StaticResource Navigation}" Click="Help_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE897;" Style="{StaticResource NavIcon}"/><TextBlock Text="Getting started"/></StackPanel></Button>
          <Button Style="{StaticResource Navigation}" Click="Updates_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" Style="{StaticResource NavIcon}"/><TextBlock Text="Updates"/></StackPanel></Button>
        </StackPanel>
        </ScrollViewer><StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,18,0,0">
          <Border BorderBrush="{DynamicResource SidebarLine}" BorderThickness="0,1,0,0" Padding="7,20,7,0">
            <StackPanel>
              <TextBlock Text="CONNECTED SERVICES" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="{DynamicResource SidebarMuted}"/>
              <TextBlock Text="Toggl → Copilot → Quickbase" FontSize="11" Foreground="{DynamicResource SidebarInk}" Margin="0,8,0,22"/>
              <TextBlock x:Name="ProfileLabel" Text="Set up your account" FontWeight="SemiBold" Foreground="{DynamicResource SidebarInk}" FontSize="12"/>
              <TextBlock x:Name="VersionText" Text="Timekeeper · Windows" Foreground="{DynamicResource SidebarMuted}" FontSize="10" Margin="0,7,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="{DynamicResource ContentMargin}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="{DynamicResource SectionGap}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,18,0">
          <TextBlock x:Name="PageEyebrow" Text="TOGGL / QUICKBASE" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource Accent}"/>
          <TextBlock x:Name="PageTitle" Text="Timecards" FontFamily="{StaticResource DisplayFont}" FontSize="31" Margin="0,6,0,6"/>
          <TextBlock x:Name="PageSubtitle" Text="Read Toggl time or import an email workbook, review, and submit to Quickbase." Foreground="{DynamicResource Muted}" FontSize="13" TextWrapping="Wrap"/>
        </StackPanel>
        <Button Grid.Column="1" Content="Try a sample day ↗" Style="{StaticResource Quiet}" Click="Demo_Click" VerticalAlignment="Top" FontSize="12" Margin="0,15,0,0"/>
      </Grid>
      <ScrollViewer x:Name="WorkScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <StackPanel>
          <Border x:Name="DemoBanner" Visibility="Collapsed" Background="{DynamicResource WarningSoft}" CornerRadius="7" Padding="14,10" Margin="0,0,0,14">
            <TextBlock Text="SAMPLE WORKSPACE  ·  Explore the workflow with sample data. Quickbase writing is disabled." Foreground="{DynamicResource Warning}" FontSize="12"/>
          </Border>
          <Border Style="{StaticResource Card}" Padding="18,13" Margin="{DynamicResource SectionGap}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <WrapPanel VerticalAlignment="Center" Margin="0,0,20,0">
              <Button x:Name="ReadTodayButton" Content="Read today's data" Style="{StaticResource Primary}" Click="ReadToday_Click" Margin="0,0,24,6" VerticalAlignment="Bottom"/>
              <WrapPanel>
              <StackPanel Margin="0,0,10,6"><TextBlock Text="From" Foreground="{DynamicResource Muted}" FontSize="11" Margin="1,0,0,5"/><DatePicker x:Name="StartDate" Width="140" AutomationProperties.Name="Read from date"/></StackPanel>
              <StackPanel Margin="0,0,12,6"><TextBlock Text="Through" Foreground="{DynamicResource Muted}" FontSize="11" Margin="1,0,0,5"/><DatePicker x:Name="EndDate" Width="140" AutomationProperties.Name="Read through date"/></StackPanel>
              <Button x:Name="ReadRangeButton" Content="Read dates" Click="ReadRange_Click" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
              </WrapPanel>
              </WrapPanel>
              <Button x:Name="EmailImportButton" Grid.Column="1" Click="EmailImport_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="16,12" MinHeight="82"
                      AllowDrop="True" PreviewDragEnter="EmailImport_DragOver" PreviewDragOver="EmailImport_DragOver" PreviewDragLeave="EmailImport_DragLeave" PreviewDrop="EmailImport_Drop"
                      AutomationProperties.Name="Import email Excel" AutomationProperties.HelpText="Drop one Excel workbook here, or click to browse for an .xlsx file."
                      ToolTip="Drop an email Excel workbook here, or click to browse.">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><Trigger Property="Tag" Value="DropReady"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></Style.Triggers></Style></Button.Style>
                <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                  <Grid Width="48" Height="40" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Rectangle Margin="1,3" RadiusX="4" RadiusY="4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"/>
                    <Path Data="M 3,6 L 24,23 L 45,6 M 3,34 L 17,21 M 45,34 L 31,21" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineJoin="Round"/>
                  </Grid>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Import email Excel"/>
                    <TextBlock Text="Drop .xlsx or click to browse" FontSize="11" FontWeight="Normal" Margin="0,5,0,0"/>
                  </StackPanel>
                </StackPanel>
              </Button>
            </Grid>
          </Border>
          <Border Style="{StaticResource Card}" Padding="0" Margin="{DynamicResource SectionGap}">
            <UniformGrid Columns="4" Grid.IsSharedSizeScope="True">
              <Border Padding="20,14" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="MetricLabels"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="TrackedLabel" Text="Tracked in Toggl" Style="{StaticResource MetricLabel}"/><TextBlock Grid.Row="1" x:Name="TrackedMetric" Text="—" Style="{StaticResource MetricValue}"/></Grid></Border>
              <Border Padding="20,14" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="MetricLabels"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Already in Quickbase" Style="{StaticResource MetricLabel}"/><TextBlock Grid.Row="1" x:Name="ExistingMetric" Text="—" Style="{StaticResource MetricValue}"/></Grid></Border>
              <Border Padding="20,14" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="MetricLabels"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Ready to add" Style="{StaticResource MetricLabel}" Foreground="{DynamicResource Accent}"/><TextBlock Grid.Row="1" x:Name="ReadyMetric" Text="—" Style="{StaticResource MetricValue}" Foreground="{DynamicResource Accent}"/></Grid></Border>
              <Border Padding="20,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="MetricLabels"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Weekday fill target" Style="{StaticResource MetricLabel}"/><TextBlock Grid.Row="1" x:Name="TargetMetric" Text="8.00 h" Style="{StaticResource MetricValue}"/></Grid></Border>
            </UniformGrid>
          </Border>
          <Border x:Name="CopilotRefreshNotice" Visibility="Collapsed" Background="{DynamicResource WarningSoft}" BorderBrush="{DynamicResource Warning}" BorderThickness="1" CornerRadius="9" Padding="18,14" Margin="{DynamicResource SectionGap}" AutomationProperties.LiveSetting="Assertive">
            <StackPanel>
              <TextBlock Text="Assignment added. Send the updated file to Copilot again." Foreground="{DynamicResource Warning}" FontWeight="SemiBold" FontSize="17" TextWrapping="Wrap"/>
              <TextBlock Foreground="{DynamicResource Warning}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="13" LineHeight="21">
                <Run Text="1. Drag the updated file below into your Copilot chat again."/><LineBreak/>
                <Run Text="2. Ask Copilot for a new proposal using the added assignment."/><LineBreak/>
                <Run Text="3. Download the new proposal and bring it back here."/>
              </TextBlock>
              <TextBlock Text="Your previous proposal is no longer valid." Foreground="{DynamicResource Warning}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"/>
            </StackPanel>
          </Border>
          <Grid Margin="{DynamicResource SectionGap}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="18">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal"><Border Style="{StaticResource StepNumber}"><TextBlock Text="01" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Send to Copilot" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                <Border x:Name="ExportCard" Grid.Row="1" BorderThickness="1" CornerRadius="9" Padding="12,15" Margin="0,12,0,12" Cursor="Hand" MouseLeftButtonDown="Export_MouseDown" MouseMove="Export_MouseMove" ToolTip="Drag this file into your Copilot agent, or use Save file.">
                  <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource ExportLine}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ExportHover}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></Style.Triggers></Style></Border.Style>
                  <StackPanel>
                    <Grid Width="34" Height="39" HorizontalAlignment="Center" Margin="0,0,0,10">
                      <Path Data="M 6,1 L 22,1 L 31,10 L 31,37 L 3,37 L 3,1 Z" Fill="{DynamicResource Surface}" Stroke="{DynamicResource Accent}" StrokeThickness="1.3"/>
                      <Path Data="M 21,1 L 21,11 L 31,11 M 10,20 L 24,20 M 10,25 L 21,25" Stroke="{DynamicResource Accent}" StrokeThickness="1.3"/>
                    </Grid>
                    <TextBlock x:Name="ExportTitle" Text="Your file will appear here" FontFamily="{StaticResource DisplayFont}" FontSize="19" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,7"/>
                    <TextBlock x:Name="ExportDetail" Text="Start by reading your time above." TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" MinHeight="34"/>
                  </StackPanel>
                </Border>
                <WrapPanel Grid.Row="2"><Button x:Name="CopilotButton" Content="Open Copilot ↗" Click="OpenCopilot_Click" FontSize="12" Padding="12,8" Margin="0,0,8,0"/><Button x:Name="SaveExportButton" Content="Save file" Click="SaveExport_Click" IsEnabled="False" Style="{StaticResource Quiet}" FontSize="12" Padding="12,8"/></WrapPanel>
              </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal"><Border Style="{StaticResource StepNumber}"><TextBlock Text="02" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Bring back the proposal" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                <Border x:Name="ImportCard" Grid.Row="1" AllowDrop="True" DragOver="Import_DragOver" DragLeave="Import_DragLeave" Drop="Import_Drop" Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="9" Padding="12,15" Margin="0,12,0,12">
                  <StackPanel>
                    <Grid Width="38" Height="39" HorizontalAlignment="Center" Margin="0,0,0,10"><Path Data="M 19,2 L 19,24 M 12,17 L 19,24 L 26,17 M 3,25 L 3,34 L 35,34 L 35,25" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid>
                    <TextBlock Text="Drop Copilot's file here" FontFamily="{StaticResource DisplayFont}" FontSize="19" TextAlignment="Center" Margin="0,0,0,7"/>
                    <TextBlock Text="Toggl JSON proposal or email Excel workbook." TextAlignment="Center" FontSize="12" Foreground="{DynamicResource Muted}" MinHeight="34"/>
                  </StackPanel>
                </Border>
                <WrapPanel Grid.Row="2"><Button x:Name="ImportButton" Content="Open file" Click="Import_Click" IsEnabled="False" FontSize="12" Padding="12,8" Margin="0,0,8,0"/><Button x:Name="PasteButton" Content="Paste" Click="Paste_Click" IsEnabled="False" Style="{StaticResource Quiet}" FontSize="12" Padding="9,8" Margin="0,0,5,0"/><Button x:Name="FindButton" Content="Find assignment" Click="Find_Click" IsEnabled="False" Style="{StaticResource Quiet}" FontSize="12" Padding="9,8"/></WrapPanel>
              </Grid>
            </Border>
          </Grid>
          <Border Style="{StaticResource Card}" Padding="0">
            <StackPanel>
              <Grid Margin="20,18,20,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource StepNumber}"><TextBlock Text="03" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Review &amp; submit" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="ReviewTitle" Text="Waiting for your proposal" FontFamily="{StaticResource DisplayFont}" FontSize="22" Margin="0,10,0,0"/></StackPanel>
                <Border x:Name="VerifiedBadge" Grid.Column="1" VerticalAlignment="Top" Background="{DynamicResource SuccessSoft}" BorderBrush="{DynamicResource VerificationLine}" BorderThickness="1" Padding="12,6" CornerRadius="6" Visibility="Collapsed"><TextBlock Text="✓  Data verified" Foreground="{DynamicResource Success}" FontWeight="SemiBold" FontSize="12"/></Border>
              </Grid>
              <TextBlock x:Name="ValidationMessage" Text="The app checks the returned file and calculates your time before you submit." Foreground="{DynamicResource Muted}" Margin="20,0,20,14" FontSize="12"/>
              <Border x:Name="ProposalDatesPanel" Visibility="Collapsed" Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="12" Margin="20,0,20,14">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ProposalDatesText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="ChangeProposalDatesButton" Grid.Column="1" Content="Change dates" Click="ChangeProposalDates_Click"/></Grid>
              </Border>
              <DataGrid x:Name="ReviewGrid" FrozenColumnCount="2" MinHeight="100" MaxHeight="320" Visibility="Collapsed" ScrollViewer.HorizontalScrollBarVisibility="Auto" MouseDoubleClick="RowDetails_Click" ToolTip="Double-click a row to inspect its full description and field IDs.">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" ElementStyle="{StaticResource TableText}" Width="110" MinWidth="110"/>
                  <DataGridTemplateColumn Header="Hours" Width="88" MinWidth="88">
                    <DataGridTemplateColumn.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="4,2"/></Style></DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                      <TextBox Text="{Binding Hours, Mode=OneWay, StringFormat=F2}" IsReadOnly="True" IsReadOnlyCaretVisible="False" TextAlignment="Right" Padding="5,4" Margin="2" MinHeight="28" FontFamily="{StaticResource MonoFont}" ToolTip="{Binding DurationHint}" PreviewMouseDoubleClick="Duration_DoubleClick" PreviewKeyDown="Duration_KeyDown" AutomationProperties.Name="Hours. Double-click or press F2 to edit."/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Billing" Width="205" MinWidth="205">
                    <DataGridTemplateColumn.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="4,2"/></Style></DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0">
                          <Ellipse Width="9" Height="9" Fill="{Binding BillingLight}" Margin="0,0,9,0" ToolTip="{Binding BillingLabel}" AutomationProperties.Name="{Binding BillingLabel}"/>
                          <TextBlock Text="{Binding BillingLabel}" VerticalAlignment="Center" FontSize="11" ToolTip="{Binding BillingHint}">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanOverride}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                          </TextBlock>
                          <Button Content="Use default" Click="ClearBilling_Click" Margin="5,0,0,0" Padding="4,2" FontSize="10" ToolTip="Clear the requested override and use Quickbase's billing rules.">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Quiet}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasUnavailableOverride}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                          </Button>
                          <ComboBox Width="165" Height="30" MinHeight="30" SelectedIndex="{Binding BillingIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding BillingHint}" AutomationProperties.Name="Timecard billing status" FontSize="11" Padding="7,4">
                            <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers><DataTrigger Binding="{Binding CanOverride}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
                            <ComboBoxItem Content="{Binding DefaultBillingLabel}"/>
                            <ComboBoxItem Content="Billable" IsEnabled="{Binding CanOverride}"/>
                            <ComboBoxItem Content="Nonbillable" IsEnabled="{Binding CanOverride}"/>
                          </ComboBox>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" ElementStyle="{StaticResource TableText}" Width="150" MinWidth="150"/>
                  <DataGridTextColumn Header="Assignment" Binding="{Binding AssignmentName}" ElementStyle="{StaticResource TableText}" Width="145" MinWidth="145"/>
                  <DataGridTextColumn Header="Task" Binding="{Binding TaskName}" ElementStyle="{StaticResource TableText}" Width="110" MinWidth="110"/>
                  <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" ElementStyle="{StaticResource TableText}" Width="105" MinWidth="105"/>
                  <DataGridTextColumn Header="Description" Binding="{Binding Description}" ElementStyle="{StaticResource TableText}" Width="*" MinWidth="185"/>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="BillingNotice" Visibility="Collapsed" TextWrapping="Wrap" Margin="20,10,20,0" FontSize="12" Foreground="{DynamicResource Muted}"/>
              <Button x:Name="RowDetailsButton" Content="View selected row details ↗" Click="RowDetails_Click" Style="{StaticResource Quiet}" HorizontalAlignment="Left" FontSize="12" Margin="10,6,20,0" Padding="10,6" IsEnabled="False"/>
              <TextBlock x:Name="DailyTotals" Margin="20,9,20,14" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
              <TextBlock x:Name="WarningsText" Margin="20,0,20,12" Foreground="{DynamicResource Warning}" FontSize="12" Visibility="Collapsed"/>
              <CheckBox x:Name="AcknowledgeWarnings" Margin="20,0,20,16" Visibility="Collapsed" Checked="Approval_Changed" Unchecked="Approval_Changed"><TextBlock Text="I reviewed the warnings, confirmed these hours, and checked for existing timecards." TextWrapping="Wrap" FontSize="12"/></CheckBox>
              <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,16">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="WriteHint" TextWrapping="Wrap" Text="Nothing is sent until you click Write to Quickbase." VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,18,0"/><Button x:Name="WriteButton" Grid.Column="1" Content="Write to Quickbase" Style="{StaticResource Primary}" IsEnabled="False" Click="Write_Click"/></Grid>
              </Border>
            </StackPanel>
          </Border>
          <Expander Header="Source entries and existing Quickbase time" Margin="2,16,0,10" FontSize="12"><TextBox x:Name="SourceDetails" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="12" MaxHeight="240" VerticalScrollBarVisibility="Auto"/></Expander>
        </StackPanel>
      </ScrollViewer>
      <Grid x:Name="HistoryPanel" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Every submission has a saved receipt. Select one to review its result." Foreground="{DynamicResource Muted}" Margin="0,0,0,18"/>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0,8">
          <Grid>
            <DataGrid x:Name="HistoryGrid" SelectionChanged="History_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Started (local)" Binding="{Binding StartedAtUtc.LocalDateTime, StringFormat=yyyy-MM-dd HH:mm}" ElementStyle="{StaticResource TableText}" Width="170" MinWidth="170"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" ElementStyle="{StaticResource TableText}" Width="115" MinWidth="115"/><DataGridTextColumn Header="Rows" Binding="{Binding Rows.Count}" ElementStyle="{StaticResource TableNumber}" Width="70" MinWidth="70"/><DataGridTextColumn Header="Message" Binding="{Binding DisplayMessage}" ElementStyle="{StaticResource TableText}" Width="*" MinWidth="190"/></DataGrid.Columns></DataGrid>
            <StackPanel x:Name="HistoryEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30"><TextBlock Text="No submissions yet" FontFamily="{StaticResource DisplayFont}" FontSize="25" TextAlignment="Center" Margin="0,0,0,12"/><TextBlock Text="Submission receipts will appear here.&#x0a;Start by reading your timecards." TextAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="13"/></StackPanel>
          </Grid>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,18,0,0">
          <TextBlock Text="SELECTED RECEIPT" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
          <TextBox x:Name="ReceiptDetails" Text="Select a submission to inspect its receipt." IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="12" MinHeight="90" MaxHeight="200" VerticalScrollBarVisibility="Auto"/>
          <WrapPanel Margin="0,12,0,0"><Button x:Name="ReconcileButton" Content="Check selected result" Click="Reconcile_Click" Margin="0,0,10,0" IsEnabled="False"/><Button x:Name="RecoverDeletedButton" Content="Recover deleted entries" Click="RecoverDeleted_Click" Margin="0,0,10,0" IsEnabled="False"/><Button x:Name="ExportReceiptButton" Content="Export receipt" Click="ExportReceipt_Click" IsEnabled="False"/></WrapPanel>
        </StackPanel>
      </Grid>
      <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><ProgressBar x:Name="BusyBar" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,8"/><TextBlock x:Name="StatusText" Text="Ready · Set up your accounts, or explore a sample day." FontSize="12" Foreground="{DynamicResource Muted}"/></StackPanel>
          <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel read" Click="Cancel_Click" Visibility="Collapsed" FontSize="11" Padding="10,4" Margin="12,0,0,0"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
