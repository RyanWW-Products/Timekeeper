<Window x:Class="Timekeeper.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Timekeeper" Icon="Assets/Timekeeper.ico" Style="{StaticResource {x:Type Window}}" Width="1360" Height="960" MinWidth="1040" MinHeight="720" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#132F40">
      <DockPanel Margin="20,30,20,22">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="2,0,0,40"><Border Background="#43C7BD" Width="34" Height="34" CornerRadius="10"><TextBlock Text="t" FontSize="26" FontWeight="Bold" Foreground="#103243" HorizontalAlignment="Center" Margin="0,-4,0,0"/></Border><TextBlock Text="timekeeper" Foreground="White" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,0"/></StackPanel>
          <TextBlock Text="WORKSPACE" Foreground="#88A5B5" FontSize="10" FontWeight="Bold" Margin="12,0,0,12"/>
          <Button x:Name="DayNav" Content="Your timecards" Style="{StaticResource Navigation}" Click="ShowDay_Click" Background="#265063"/>
          <Button Content="Submission history" Style="{StaticResource Navigation}" Click="History_Click"/>
          <Button Content="Settings" Style="{StaticResource Navigation}" Click="Settings_Click"/>
          <Button Content="Copilot setup" Style="{StaticResource Navigation}" Click="Help_Click"/>
          <Button Content="Updates" Style="{StaticResource Navigation}" Click="Updates_Click"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
          <Border BorderBrush="#305060" BorderThickness="0,1,0,0" Padding="0,19,0,0"><StackPanel><TextBlock Text="CONNECTED WORKFLOW" FontSize="10" FontWeight="Bold" Foreground="#88A5B5"/><TextBlock Text="Toggl → Copilot → Quickbase" FontSize="11" Foreground="#C6DBE5" Margin="0,8,0,16"/><TextBlock x:Name="ProfileLabel" Text="Set up your account" FontWeight="SemiBold" Foreground="White" FontSize="12"/><TextBlock x:Name="VersionText" Text="Timekeeper · Windows" Foreground="#88A5B5" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border>
        </StackPanel>
        <Grid/>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="32,25,32,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,20">
        <StackPanel><TextBlock Text="DAILY TIMECARDS" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="PageTitle" Text="Your day, ready to submit." FontSize="29" FontWeight="SemiBold" Margin="0,5,0,5"/><TextBlock x:Name="PageSubtitle" Text="Read your time. Resolve the details. Review and send." Foreground="{StaticResource Muted}"/></StackPanel>
        <Button Content="Try a sample day" Click="Demo_Click" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="12" Padding="13,8"/>
      </Grid>
      <ScrollViewer x:Name="WorkScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <StackPanel>
          <Border x:Name="DemoBanner" Visibility="Collapsed" Background="#FFF1D1" CornerRadius="7" Padding="14,10" Margin="0,0,0,16"><TextBlock Text="DEMO · Sample data only. Quickbase writing is disabled. Read your data to leave demo." Foreground="#775615" FontSize="12"/></Border>
          <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
            <WrapPanel VerticalAlignment="Center">
              <Button x:Name="ReadTodayButton" Content="Read today's data" Style="{StaticResource Primary}" Click="ReadToday_Click" Margin="0,0,20,0"/>
              <StackPanel Margin="0,0,10,0"><TextBlock Text="FROM" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}"/><DatePicker x:Name="StartDate" Width="128" Margin="0,3,0,0"/></StackPanel>
              <StackPanel Margin="0,0,10,0"><TextBlock Text="THROUGH" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}"/><DatePicker x:Name="EndDate" Width="128" Margin="0,3,0,0"/></StackPanel>
              <Button x:Name="ReadRangeButton" Content="Read dates" Click="ReadRange_Click" Margin="0,0,0,0" VerticalAlignment="Bottom"/>
            </WrapPanel>
          </Border>
          <UniformGrid Columns="4" Margin="0,0,0,20">
            <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16"><StackPanel><TextBlock Text="TRACKED IN TOGGL" FontSize="10" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/><TextBlock x:Name="TrackedMetric" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16"><StackPanel><TextBlock Text="ALREADY IN QUICKBASE" FontSize="10" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/><TextBlock x:Name="ExistingMetric" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16"><StackPanel><TextBlock Text="READY TO ADD" FontSize="10" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/><TextBlock x:Name="ReadyMetric" Text="—" FontSize="29" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock Text="WEEKDAY FILL TARGET" FontSize="10" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/><TextBlock x:Name="TargetMetric" Text="8.00 h" FontSize="29" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
          </UniformGrid>
          <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="20">
              <StackPanel>
                <TextBlock Text="01  SEND TO COPILOT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                <Border x:Name="ExportCard" Background="#E9F5F3" BorderBrush="#9DCFC9" BorderThickness="1" CornerRadius="9" Padding="16,22" Margin="0,14,0,12" Cursor="Hand" MouseLeftButtonDown="Export_MouseDown" MouseMove="Export_MouseMove" ToolTip="Drag this file into your Copilot agent, or use Save file.">
                  <StackPanel HorizontalAlignment="Center"><TextBlock Text="⇧" Foreground="{StaticResource Accent}" FontSize="32" HorizontalAlignment="Center"/><TextBlock x:Name="ExportTitle" Text="Your file will appear here" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" Margin="0,8,0,5"/><TextBlock x:Name="ExportDetail" Text="Start by reading your time above." TextAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel>
                </Border>
                <WrapPanel><Button x:Name="CopilotButton" Content="Open Copilot ↗" Click="OpenCopilot_Click" FontSize="12" Padding="12,8" Margin="0,0,8,0"/><Button x:Name="SaveExportButton" Content="Save file" Click="SaveExport_Click" IsEnabled="False" FontSize="12" Padding="12,8"/></WrapPanel>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
              <StackPanel>
                <TextBlock Text="02  BRING BACK THE PROPOSAL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                <Border x:Name="ImportCard" AllowDrop="True" DragOver="Import_DragOver" Drop="Import_Drop" Background="#F5F7FA" BorderBrush="#C6D2DC" BorderThickness="1" CornerRadius="9" Padding="16,22" Margin="0,14,0,12">
                  <StackPanel><TextBlock Text="⇩" Foreground="#718A9E" FontSize="32" HorizontalAlignment="Center"/><TextBlock Text="Drop Copilot's file here" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" Margin="0,8,0,5"/><TextBlock Text="Download the proposal, then drag it here." TextAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel>
                </Border>
                <WrapPanel><Button x:Name="ImportButton" Content="Open file" Click="Import_Click" IsEnabled="False" FontSize="12" Padding="12,8" Margin="0,0,8,0"/><Button x:Name="PasteButton" Content="Paste" Click="Paste_Click" IsEnabled="False" FontSize="12" Padding="12,8" Margin="0,0,8,0"/><Button x:Name="FindButton" Content="Find assignment" Click="Find_Click" IsEnabled="False" FontSize="12" Padding="10,8"/></WrapPanel>
              </StackPanel>
            </Border>
          </Grid>
          <Border Style="{StaticResource Card}" Padding="0">
            <StackPanel>
              <Grid Margin="20,18"><StackPanel><TextBlock Text="03  REVIEW &amp; SUBMIT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ReviewTitle" Text="Waiting for your proposal" FontSize="19" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel><Border x:Name="VerifiedBadge" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#DDF3E7" Padding="12,7" CornerRadius="15" Visibility="Collapsed"><TextBlock Text="✓  Data verified" Foreground="#21643F" FontWeight="SemiBold" FontSize="12"/></Border></Grid>
              <TextBlock x:Name="ValidationMessage" Text="The app checks the returned file and calculates your time before you submit." Foreground="{StaticResource Muted}" Margin="20,0,20,16" FontSize="12"/>
              <DataGrid x:Name="ReviewGrid" MinHeight="100" MaxHeight="320" Visibility="Collapsed" ScrollViewer.HorizontalScrollBarVisibility="Auto" MouseDoubleClick="RowDetails_Click" ToolTip="Double-click a row to inspect its full description and field IDs.">
                <DataGrid.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGrid.Resources>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="98"/>
                  <DataGridTextColumn Header="Hours" Binding="{Binding Hours, StringFormat=F2}" Width="64"/>
                  <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="150"/>
                  <DataGridTextColumn Header="Assignment" Binding="{Binding AssignmentName}" Width="140"/>
                  <DataGridTextColumn Header="Task" Binding="{Binding TaskName}" Width="125"/>
                  <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="95"/>
                  <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="175"/>
                </DataGrid.Columns>
              </DataGrid>
              <Button Content="View selected row details" Click="RowDetails_Click" HorizontalAlignment="Left" FontSize="11" Margin="20,12,20,0" Padding="10,6"/>
              <TextBlock x:Name="DailyTotals" Margin="20,14,20,8" FontWeight="SemiBold" FontSize="12"/>
              <TextBlock x:Name="WarningsText" Margin="20,0,20,10" Foreground="#835D14" FontSize="12" Visibility="Collapsed"/>
              <CheckBox x:Name="AcknowledgeWarnings" Content="I reviewed the warnings and confirmed the existing-record matches and fill time." Margin="20,0,20,12" Visibility="Collapsed" Checked="Approval_Changed" Unchecked="Approval_Changed"/>
              <Grid Margin="20,4,20,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="WriteHint" Text="Nothing is sent until you click Write to Quickbase." VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,14,0"/><Button x:Name="WriteButton" Grid.Column="1" Content="Write to Quickbase" Style="{StaticResource Primary}" IsEnabled="False" Click="Write_Click"/></Grid>
            </StackPanel>
          </Border>
          <Expander Header="Source entries and existing Quickbase time" Margin="0,18,0,10"><TextBox x:Name="SourceDetails" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontSize="12" MaxHeight="240" VerticalScrollBarVisibility="Auto"/></Expander>
        </StackPanel>
      </ScrollViewer>
      <Grid x:Name="HistoryPanel" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Every write has a local receipt. An uncertain result must be checked before retrying." Foreground="{StaticResource Muted}" Margin="0,0,0,18"/><DataGrid x:Name="HistoryGrid" Grid.Row="1" SelectionChanged="History_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Started" Binding="{Binding StartedAtUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="170"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/><DataGridTextColumn Header="Rows" Binding="{Binding Rows.Count}" Width="70"/><DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Margin="0,18,0,0"><TextBox x:Name="ReceiptDetails" IsReadOnly="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="240" VerticalScrollBarVisibility="Auto"/><WrapPanel Margin="0,12,0,0"><Button Content="Check selected result" Click="Reconcile_Click" Margin="0,0,10,0"/><Button Content="Export receipt" Click="ExportReceipt_Click"/></WrapPanel></StackPanel></Grid>
      <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><ProgressBar x:Name="BusyBar" Height="3" IsIndeterminate="True" Visibility="Collapsed" Foreground="{StaticResource Accent}" Margin="0,0,0,8"/><TextBlock x:Name="StatusText" Text="Ready · Set up your accounts, or explore a sample day." FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel><Button x:Name="CancelButton" Grid.Column="1" Content="Cancel read" Click="Cancel_Click" Visibility="Collapsed" FontSize="11" Padding="10,4" Margin="12,0,0,0"/></Grid>
    </Grid>
  </Grid>
</Window>
